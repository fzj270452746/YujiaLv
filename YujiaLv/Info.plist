<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  只放启动屏这一段。工程开着 GENERATE_INFOPLIST_FILE，其余键（Bundle 名、权限文案、
	  方向等）仍由 Xcode 生成并合并进来，不要在这里重复声明。

	  这个文件必须留在工程根目录，也就是 YujiaLv/ 这个 file-system-synchronized group 的**外面**：
	  同步组会把目录里的文件平铺拷进 bundle 根，Info.plist 撞上 ProcessInfoPlistFile 的输出路径
	  会直接报 "Multiple commands produce"。
	-->
	<key>UILaunchScreen</key>
	<dict>
		<!-- 与 Theme.background / SplashView 背景同色，接缝才看不出来 -->
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<!-- 与 SplashView 里 Image("LaunchLogo") 同资源同尺寸，都是 96pt -->
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<!-- 显式要求「相对整屏居中」，与 SplashView 的 .ignoresSafeArea() 语义对齐 -->
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
